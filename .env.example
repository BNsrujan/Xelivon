# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# REQUIRED. Database connection.
#   Local dev (SQLite, the default):  file:./dev.db
#   Production (Postgres): postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#   NOTE: switching to Postgres also means changing `provider` in
#         prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL=

# OPTIONAL. Public site origin, used for metadata and OG tags.
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL. Address shown in the contact section and footer.
# Defaults to support@axearc.com.
NEXT_PUBLIC_CONTACT_EMAIL=

# OPTIONAL. Calendly event URL embedded in the booking section.
# Defaults to the founder's existing 30-minute link.
NEXT_PUBLIC_CALENDLY_URL=

# OPTIONAL. Social links. Each icon is hidden until its URL is set.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FOUNDER_LINKEDIN=

# OPTIONAL. Founder headshot placed in /public, e.g. /founder.jpg
# Leave blank to show a monogram instead.
NEXT_PUBLIC_FOUNDER_PHOTO=
