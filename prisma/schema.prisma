// Axearc data model.
//
// PostgreSQL in every environment. DATABASE_URL is read from prisma.config.ts
// (CLI) and passed to the driver adapter in src/lib/prisma.ts (runtime).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A practice area Axearc sells (AI automation, branding, web, ...).
/// Drives the service cards on the marketing page and the dropdown on the
/// contact form, so adding a service is a seed change, not a code change.
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  icon        String // lucide-react icon name, resolved client-side
  accent      String // tailwind classes for the icon chip
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]
  posts Post[]

  @@index([published, order])
}

/// A contact-form submission. This is the conversion event of the whole site.
model Lead {
  id        String     @id @default(cuid())
  firstName String
  lastName  String
  email     String
  company   String?
  message   String
  source    LeadSource @default(CONTACT_FORM)
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Which practice area the visitor asked about. Optional: a lead that arrives
  // before picking a service is still a lead worth keeping.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([serviceId])
}

enum LeadSource {
  CONTACT_FORM
  HERO_CTA
  FOOTER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

/// An insight article. Categorised by practice area so the blog and the
/// services list stay in sync.
model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  readMinutes Int       @default(4)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
  @@index([serviceId])
}

/// Footer email capture. Deliberately standalone: subscribing is not a lead.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?
}
